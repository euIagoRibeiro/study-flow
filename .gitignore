# Regras que valem pro monorepo inteiro.
# Regras específicas de cada pasta ficam em frontend/.gitignore e backend/.gitignore.

# Dependências
node_modules

# Variáveis de ambiente (segredos: string do Supabase, hash da senha, segredo do token)
# Só o .env.example (nomes das variáveis, sem valores) vai pro git
.env
.env.*
!.env.example

# Logs
logs
*.log

# Sistema operacional
.DS_Store
Thumbs.db

# Editor
.idea
.vscode/*
!.vscode/extensions.json

# Contexto e configuração do Claude Code: ficam só na máquina local,
# o GitHub mostra apenas o projeto (README + frontend + backend)
CLAUDE.md
CLAUDE.local.md
.claude/
docs/progresso.md
