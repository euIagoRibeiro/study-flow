DATABASE_URL=postgres://studyflow:CHANGE_ME@localhost:5432/studyflow
# Fora de localhost / 127.0.0.1 / ::1: o certificado da CA do banco, em PEM (o
# conteúdo, não o caminho). Sem ele, a API não sobe. A DATABASE_URL não pode ter
# ssl, sslmode, sslrootcert, sslcert, sslkey, sslnegotiation nem uselibpqcompat,
# e NODE_TLS_REJECT_UNAUTHORIZED não pode existir no ambiente
DATABASE_CA_CERT=
PORT=3333
# Trava: a API não sobe sem os dois. Hash: node scripts/hash-senha.mjs (lê a
# senha sem eco; mínimo 16 caracteres). Segredo: 32 bytes aleatórios em hex, ex.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o SESSION_SECRET derruba todas as sessões (o botão de pânico)
AUTH_PASSWORD_HASH=
SESSION_SECRET=
# false em dev; na hospedagem, o número de proxies na frente da API
TRUST_PROXY=false
# Só dev, NUNCA em produção (lá a variável não existe e vale 300): limite geral
# por IP, em pedidos por minuto. Aceita de 30 a 1500; fora disso vale 300. As
# baterias saem todas do mesmo IP e chegam a ~950 por minuto: 1500. A API diz o
# limite em vigor na linha "API rodando…" da partida
RATE_LIMIT_PER_MIN=1500
# Só dev: a senha que as baterias usam (o hash dela no AUTH_PASSWORD_HASH).
# Nunca a senha de produção
TEST_PASSWORD=
