DATABASE_URL=postgres://studyflow:CHANGE_ME@localhost:5432/studyflow
PORT=3333
# Trava: a API não sobe sem os dois. Hash: node scripts/hash-senha.mjs (lê a
# senha sem eco; mínimo 16 caracteres). Segredo: 32 bytes aleatórios em hex, ex.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar o SESSION_SECRET derruba todas as sessões (o botão de pânico)
AUTH_PASSWORD_HASH=
SESSION_SECRET=
# false em dev; na hospedagem, o número de proxies na frente da API
TRUST_PROXY=false
# Só dev: a senha que as baterias usam (o hash dela no AUTH_PASSWORD_HASH).
# Nunca a senha de produção
TEST_PASSWORD=
